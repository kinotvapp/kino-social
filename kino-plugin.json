{
  "id": "kino-social",
  "name": "Kino Social",
  "version": "0.9.7",
  "apiVersion": 16,
  "entry": "plugin.js",
  "description": "Experimento: un feed para contar lo que ves, con comentarios, perfiles y personas a las que seguir",
  "author": "kinotvapp",
  "icon": "icon.png",
  "hosts": [
    "129-158-250-81.sslip.io"
  ],
  "fetchHosts": "any",
  "welcomeNotice": {
    "title": "¡Bienvenido a Kino Social!",
    "titleEn": "Welcome to Kino Social!",
    "text": "Ven y mira lo que pasa en la comunidad",
    "textEn": "Come and see what is going on in the community"
  },
  "capabilities": [
    "screen",
    "library",
    "tracking",
    "identity",
    "ai",
    "schedule",
    "notifications",
    "playerPanelTab",
    "coins"
  ],
  "settings": [
    {
      "key": "dailyBalance",
      "label": "Aviso diario de saldo",
      "labelEn": "Daily balance notice",
      "type": "toggle",
      "default": true,
      "hint": "Hacia las 8 p. m., si tienes kinos",
      "hintEn": "Around 8 p.m., if you have Kinos"
    }
  ],
  "jobs": [
    {
      "id": "notices",
      "label": {
        "es": "Avisos de Kino Social",
        "en": "Kino Social notices"
      },
      "everyMin": 15,
      "everyOptions": [
        15,
        30,
        60,
        180
      ],
      "runOn": "any"
    },
    {
      "id": "coins",
      "label": {
        "es": "Aviso diario de saldo",
        "en": "Daily balance notice"
      },
      "everyMin": 60,
      "everyOptions": [
        60,
        180
      ],
      "runOn": "any",
      "enabledBy": "dailyBalance"
    }
  ],
  "screen": {
    "label": "Kino Social",
    "labelEn": "Kino Social",
    "icon": "person",
    "menuOpens": "screen"
  },
  "panel": {
    "contributes": true,
    "label": "Kino Social",
    "labelEn": "Kino Social",
    "icon": "mood"
  },
  "enhancements": {
    "20": {
      "provides": {
        "wall": {
          "summary": "Propone publicaciones para tu muro de Kino Social; tú las revisas y las publicas",
          "calls": {
            "share": {
              "in": "Share",
              "out": {
                "status": "string",
                "draftId": "string",
                "pending": "number"
              }
            }
          },
          "types": {
            "Share": {
              "text": "string?",
              "title": "Title?",
              "link": "string?",
              "from": "string?"
            },
            "Title": {
              "kind": "string",
              "tmdb": "number",
              "season": "number?",
              "episode": "number?"
            }
          }
        }
      }
    }
  },
  "signature": {
    "authorKey": "82b87b938e0a95b142467c815a8823cb54310a13a828c3c4c77b1eda43294ae6",
    "value": "a5b0059b77ebfa2a0b0a5b90e2a5225df2304dc2c5f9fa90e86c6fd22209cb09ceb5fb10b2ba987ca7822e87d4e4bd9e5ef01b6d34875ed8531401f15946ce0d"
  }
}
