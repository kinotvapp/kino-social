{
  "id": "kino-social",
  "name": "Kino Social",
  "version": "0.9.10",
  "apiVersion": 16,
  "entry": "plugin.js",
  "description": "Experimento: un feed para contar lo que ves, con comentarios, perfiles y personas a las que seguir",
  "author": "kinotvapp",
  "icon": "icon.png",
  "hosts": [
    "129-158-250-81.sslip.io"
  ],
  "fetchHosts": "any",
  "welcomeNotice": {
    "title": "¡Bienvenido a Kino Social!",
    "titleEn": "Welcome to Kino Social!",
    "text": "Ven y mira lo que pasa en la comunidad",
    "textEn": "Come and see what is going on in the community"
  },
  "capabilities": [
    "screen",
    "library",
    "tracking",
    "identity",
    "ai",
    "schedule",
    "notifications",
    "playerPanelTab",
    "coins"
  ],
  "settings": [
    {
      "key": "dailyBalance",
      "label": "Aviso diario de saldo",
      "labelEn": "Daily balance notice",
      "type": "toggle",
      "default": true,
      "hint": "Hacia las 8 p. m., si tienes kinos",
      "hintEn": "Around 8 p.m., if you have Kinos"
    },
    {
      "key": "directPublishers",
      "label": "Plugins que publican directo",
      "labelEn": "Plugins that post directly",
      "type": "list",
      "max": 20,
      "hint": "Publican en tu muro sin pasar por tu revisión",
      "hintEn": "They post to your wall without your review",
      "fields": [
        {
          "key": "repo",
          "label": "Dirección",
          "labelEn": "Address",
          "type": "text",
          "required": true
        },
        {
          "key": "name",
          "label": "Nombre",
          "labelEn": "Name",
          "type": "text"
        }
      ]
    }
  ],
  "jobs": [
    {
      "id": "notices",
      "label": {
        "es": "Avisos de Kino Social",
        "en": "Kino Social notices"
      },
      "everyMin": 15,
      "everyOptions": [
        15,
        30,
        60,
        180
      ],
      "runOn": "any"
    },
    {
      "id": "coins",
      "label": {
        "es": "Aviso diario de saldo",
        "en": "Daily balance notice"
      },
      "everyMin": 60,
      "everyOptions": [
        60,
        180
      ],
      "runOn": "any",
      "enabledBy": "dailyBalance"
    }
  ],
  "screen": {
    "label": "Kino Social",
    "labelEn": "Kino Social",
    "icon": "person",
    "menuOpens": "screen"
  },
  "panel": {
    "contributes": true,
    "label": "Kino Social",
    "labelEn": "Kino Social",
    "icon": "mood"
  },
  "enhancements": {
    "20": {
      "provides": {
        "wall": {
          "summary": "Propone publicaciones y tarjetas para tu muro de Kino Social; tú las revisas",
          "calls": {
            "share": {
              "in": "Share",
              "out": "Answer"
            },
            "card": {
              "in": "Card",
              "out": "Answer"
            }
          },
          "types": {
            "Share": {
              "text": "string?",
              "title": "Title?",
              "link": "string?",
              "from": "string?",
              "publish": "boolean?"
            },
            "Title": {
              "kind": "string",
              "tmdb": "number",
              "season": "number?",
              "episode": "number?"
            },
            "Card": {
              "title": "string",
              "description": "string?",
              "image": "string?",
              "route": "Route?",
              "query": "string?",
              "text": "string?",
              "publish": "boolean?"
            },
            "Route": {
              "name": "string",
              "argsJson": "string?"
            },
            "Answer": {
              "status": "string",
              "draftId": "string?",
              "pending": "number?",
              "postId": "number?"
            }
          }
        }
      }
    }
  },
  "signature": {
    "authorKey": "82b87b938e0a95b142467c815a8823cb54310a13a828c3c4c77b1eda43294ae6",
    "value": "625a0444200d79d15e87a3ce7209ddd10691ecf419a36719edbda7dba99d3bcd7c248d9d1e4e209bb3ab1a3aee4c7522019d46f3d07bceec3864466184aa610d"
  }
}
